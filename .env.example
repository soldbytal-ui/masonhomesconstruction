# Copy to .env and fill in. Never commit .env.

# --- DataForSEO ---
# Sign in at app.dataforseo.com → API Access. Uses HTTP Basic Auth.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Set to "sandbox" while wiring scripts up (free), "live" when ready to spend.
DATAFORSEO_MODE=sandbox

# --- Firecrawl ---
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Deploy ---
# Vercel not configured yet. When ready, add VERCEL_* vars and wire up scripts/deploy.py.

# --- Project constants (don't usually change) ---
SITE_DOMAIN=masonhomesconstruction.com
SITE_LOCATION_CODE=1023191   # DataForSEO location code: Tampa-St.Petersburg-Clearwater FL DMA
SITE_LANGUAGE_CODE=en
TARGET_LOCATION_NAME=Tampa,Florida,United States
